{
  "name": "dpdpready-ai",
  "version": "1.0.0",
  "description": "DPDPReady AI — Multi-agent operations platform for DPDP compliance",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "test": "node --test tests",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dpdpreadyai --local",
    "db:migrate": "wrangler d1 migrations apply dpdpreadyai --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
