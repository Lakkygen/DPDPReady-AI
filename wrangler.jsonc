{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dpdpready-ai",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dpdpreadyai",
      "database_id": "c927d9d1-e99c-426d-a55d-ef231350f601",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "APP_NAME": "DPDPReady AI",
    "APP_URL": "https://dpdpready.onrender.com",
    "LLM_TIMEOUT_MS": "25000",
    "APPROVAL_TTL_MS": "900000"
  }
}
